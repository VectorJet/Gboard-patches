<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.vectorjet.navfix"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Runtime Resource Overlay shrinking Pixel Launcher Taskbar nav inset.
         Target: com.google.android.apps.nexuslauncher (provides navigationBars
         via Taskbar window fillx60 on Lineage lyriq). -->
    <overlay
        android:targetPackage="com.google.android.apps.nexuslauncher"
        android:isStatic="false"
        android:priority="10" />

    <application android:hasCode="false" />
</manifest>
